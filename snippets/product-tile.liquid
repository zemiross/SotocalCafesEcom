{%- comment -%}
  Product tile: packshot standing on a --sand plane with a contact shadow (no card container, brief §5.3);
  name, character line, price with €/kg and "IVA incluído", quick add. Params: product, loading ('lazy'), heading ('h3').
{%- endcomment -%}
{%- liquid
  assign tag = heading | default: 'h3'
  assign load = loading | default: 'lazy'
  assign img = product.featured_image
  assign alt = img.alt
  if alt == blank
    assign alt = product.title
  endif
-%}
<article class="tile">
  <div class="tile__media">
    {%- if img -%}
      {{ img | image_url: width: 700 | image_tag: widths: '240, 360, 480, 600, 700', sizes: '(min-width: 1024px) 22vw, 44vw', loading: load, alt: alt }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <{{ tag }} class="tile__title"><a href="{{ product.url }}">{{ product.title }}</a></{{ tag }}>
  {%- if product.metafields.sotocal.character != blank -%}<p class="tile__char">{{ product.metafields.sotocal.character.value }}</p>{%- endif -%}
  {% render 'price', product: product, show_from: true %}
  <div class="tile__actions">{% render 'quick-add', product: product %}</div>
</article>
