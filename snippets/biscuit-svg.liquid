{%- comment -%}
  Placeholder for asset A5: a round Maria-style biscuit (scalloped edge, docking holes, no brand embossing),
  one third dipped in espresso with a glossy line. Colours are derived from the locked tokens.
{%- endcomment -%}
<svg class="consent__biscuit" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="BiscuitShape"><circle cx="50" cy="50" r="44"/></clipPath>
    <linearGradient id="BiscuitEspresso" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#3A1A0B"/><stop offset="1" stop-color="#120401"/>
    </linearGradient>
  </defs>
  <g style="fill: color-mix(in oklab, var(--sand-deep) 72%, var(--accent))">
    <circle cx="50" cy="50" r="44"/>
    <circle cx="50" cy="50" r="44" fill="none" style="stroke: color-mix(in oklab, var(--sand-deep) 72%, var(--accent))" stroke-width="9" stroke-dasharray=".01 11.52" stroke-linecap="round"/>
  </g>
  <circle cx="50" cy="50" r="37" fill="none" style="stroke: color-mix(in oklab, var(--sand-deep) 45%, var(--accent))" stroke-width="1"/>
  <g style="fill: color-mix(in oklab, var(--sand-deep) 40%, var(--accent))">
    <circle cx="50" cy="50" r="1.6"/>
    <circle cx="50" cy="30" r="1.4"/><circle cx="50" cy="70" r="1.4"/><circle cx="30" cy="50" r="1.4"/><circle cx="70" cy="50" r="1.4"/>
    <circle cx="36" cy="36" r="1.4"/><circle cx="64" cy="36" r="1.4"/><circle cx="36" cy="64" r="1.4"/><circle cx="64" cy="64" r="1.4"/>
    <circle cx="50" cy="18" r="1.2"/><circle cx="50" cy="82" r="1.2"/><circle cx="18" cy="50" r="1.2"/><circle cx="82" cy="50" r="1.2"/>
  </g>
  <g clip-path="url(#BiscuitShape)">
    <path d="M100 52 L52 100 L100 100Z" fill="url(#BiscuitEspresso)" transform="translate(-7 -7) scale(1.07)"/>
    <path d="M100 52 L52 100" transform="translate(-7 -7) scale(1.07)" style="stroke: color-mix(in oklab, var(--cream-hi) 70%, transparent)" stroke-width="1.6" stroke-linecap="round"/>
  </g>
  <g style="fill: #120401">
    <circle cx="86" cy="80" r="3.2"/><circle cx="80" cy="86" r="3.2"/><circle cx="74" cy="91" r="3"/>
  </g>
</svg>
