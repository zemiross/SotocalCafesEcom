{%- comment -%}
  Quick add. Single-variant products add directly; others open a small dialog with a native <select> of variants
  (conventional and accessible, no JS mapping needed). Param: product.
{%- endcomment -%}
{%- assign v = product.selected_or_first_available_variant -%}
{%- if product.available == false -%}
  <button class="btn btn--outline btn--sm" type="button" disabled>{{ 'product.sold_out' | t }}</button>
{%- elsif product.has_only_default_variant -%}
  {%- form 'product', product, data-cart-add: '' -%}
    <input type="hidden" name="id" value="{{ v.id }}">
    <button class="btn btn--outline btn--sm" type="submit">{% render 'icon', name: 'plus', class: 'icon--sm' %}{{ 'product.quick_add' | t }}<span class="visually-hidden">: {{ product.title }}</span></button>
  {%- endform -%}
{%- else -%}
  {%- assign dialog_id = 'QuickAdd-' | append: product.id -%}
  <button class="btn btn--outline btn--sm" type="button" aria-haspopup="dialog" aria-controls="{{ dialog_id }}" data-quick-add-open="{{ dialog_id }}">
    {% render 'icon', name: 'plus', class: 'icon--sm' %}{{ 'product.quick_add' | t }}<span class="visually-hidden">: {{ product.title }}</span>
  </button>
  <dialog class="quick-add__panel" id="{{ dialog_id }}" aria-labelledby="{{ dialog_id }}-title">
    <div class="stack" style="--stack: 16px">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:16px">
        <p class="h4" id="{{ dialog_id }}-title">{{ product.title }}</p>
        <button class="icon-btn" type="button" data-dialog-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'general.close' | t }}</span></button>
      </div>
      {%- form 'product', product, data-cart-add: '' -%}
        <div class="field">
          <label for="{{ dialog_id }}-variant">{{ product.options | join: ' / ' }}</label>
          <select class="select" id="{{ dialog_id }}-variant" name="id">
            {%- for variant in product.variants -%}
              {%- capture unit -%}{% render 'unit-price', variant: variant, plain: true %}{%- endcapture -%}
              <option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}{% if variant.id == v.id %} selected{% endif %}>
                {{ variant.title }} – {{ variant.price | money }} {% if unit != blank %}({{ unit | strip }}){% endif %}{% unless variant.available %} – {{ 'product.sold_out' | t }}{% endunless %}
              </option>
            {%- endfor -%}
          </select>
        </div>
        <p class="small muted" style="margin-top:8px">{{ 'product.tax_included' | t }}</p>
        <input type="hidden" name="quantity" value="1">
        <button class="btn btn--primary btn--block" type="submit" style="margin-top:16px">{{ 'product.add_to_cart' | t }}</button>
      {%- endform -%}
      <a class="text-link" href="{{ product.url }}">{{ 'product.view_full' | t }}</a>
    </div>
  </dialog>
{%- endif -%}
