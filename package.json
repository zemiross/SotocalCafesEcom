{
  "name": "sotocal-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Sotocal Shopify Online Store 2.0 theme (pt-PT / EN)",
  "type": "module",
  "scripts": {
    "harvest": "node scripts/harvest.mjs",
    "vendor": "node scripts/vendor.mjs",
    "placeholders": "node scripts/make-placeholders.mjs",
    "prototype": "node scripts/build-prototype.mjs",
    "serve": "node scripts/serve.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:theme": "node scripts/theme-check.mjs",
    "check:jsonld": "node scripts/check-jsonld.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "test": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "qa": "npm run check:theme && npm run check:locales && npm run check:events && npm run check:redirects && npm run prototype && npm run check:jsonld && npm run check:seo && npm run check:budgets && playwright test",
    "store-setup": "node scripts/store-setup.mjs",
    "check:guides": "node scripts/check-guides.mjs",
    "check:events": "node scripts/check-events.mjs",
    "ledger": "node scripts/ledger.mjs",
    "test:lead": "node --test store-setup/lead-endpoint/handler.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@shopify/theme-check-node": "^3.31.0",
    "gsap": "3.13.0",
    "leaflet": "1.9.4",
    "lighthouse": "^13.6.0",
    "linkinator": "^8.1.0",
    "liquidjs": "^10.30.0",
    "sharp": "^0.35.5"
  }
}
