<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#210000">
    <meta name="robots" content="noindex">
    <title>{{ 'password.heading' | t }} | Sotocal</title>
    <meta name="description" content="{{ 'password.text' | t | escape }}">
    {%- render 'fonts' -%}
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'sections-pages.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-password" data-theme="ink">
    <a class="skip-link" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>
    {%- render 'icon-sprite' -%}
    {%- render 'cookie-banner' -%}
    <main id="main" tabindex="-1">{{ content_for_layout }}</main>
    <script>
      window.Sotocal = { locale: {{ request.locale.iso_code | json }}, routes: { root: {{ routes.root_url | json }} }, assets: { consent: {{ 'consent.js' | asset_url | json }} }, strings: {} };
    </script>
  </body>
</html>
