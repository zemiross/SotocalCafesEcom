{%- comment -%} Theme block: button. Only one primary (accent) button per section (Von Restorff). {%- endcomment -%}
{%- if block.settings.label != blank -%}
<p {{ block.shopify_attributes }}><a class="btn {% if block.settings.style == 'primary' %}btn--primary{% else %}btn--outline{% endif %}" href="{{ block.settings.link }}">{{ block.settings.label }}</a></p>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.button.name",
  "settings": [
    { "type": "text", "id": "label", "label": "t:settings.cta_label" },
    { "type": "url", "id": "link", "label": "t:settings.cta_link" },
    { "type": "select", "id": "style", "label": "t:blocks.button.style", "default": "outline", "options": [ { "value": "primary", "label": "t:blocks.button.primary" }, { "value": "outline", "label": "t:blocks.button.outline" } ] }
  ],
  "presets": [{ "name": "t:blocks.button.name" }]
}
{% endschema %}
