{%- comment -%} Product FAQs (brief §8): up to 3 from sotocal.faq (faq_item references), with FAQPage schema. Ink band (§5.8). {%- endcomment -%}
{%- liquid
  assign items = product.metafields.sotocal.faq.value
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'product.faq_heading' | t
  endif
-%}
{%- if items.size > 0 -%}
<section class="section section--tight product-faq" data-theme="{{ section.settings.theme }}" aria-labelledby="Faq-{{ section.id }}">
  <div class="container grid">
    <h2 class="h2 col-left" id="Faq-{{ section.id }}">{{ heading }}</h2>
    <div class="col-right">{% render 'faq-list', items: items, limit: section.settings.limit %}</div>
  </div>
</section>
{%- elsif request.design_mode or settings.show_tbc_markers -%}
<section class="section section--tight" data-theme="{{ section.settings.theme }}">
  <div class="container"><p>{% render 'tbc', note: 'perguntas frequentes do produto (metafield sotocal.faq)' %}</p></div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.product_faq.name",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "select", "id": "theme", "label": "t:settings.theme", "default": "ink", "options": [ { "value": "cream", "label": "t:settings.cream" }, { "value": "ink", "label": "t:settings.ink" } ] },
    { "type": "text", "id": "heading", "label": "t:settings.heading", "info": "t:settings.blank_uses_default" },
    { "type": "range", "id": "limit", "label": "t:sections.product_faq.limit", "min": 1, "max": 6, "step": 1, "default": 3 }
  ]
}
{% endschema %}
