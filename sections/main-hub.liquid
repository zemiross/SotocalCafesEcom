{%- comment -%}
  Method hub and machine page (docs/seo/05-ws5-hubs.md). One section for both metaobject types; the object is `metaobject`
  (templates/metaobject/method.json and machine.json). Everything comes from fields; nothing is hard-coded copy.
  Order: answer block, Sotocal's own recommendation (the part no sibling page has), recommended blends, how-to, mistakes,
  machines (method hubs), manufacturer settings with sources (machine pages), FAQ.
  Pages that lack the required pieces are noindexed in snippets/robots-meta.liquid.
{%- endcomment -%}
{%- liquid
  assign m = metaobject
  assign hub_type = m.system.type
  assign author = m.author.value
  assign byline = author.name.value | default: shop.name
  assign blends = m.recommended_blends.value
  assign faq_items = m.faq.value
  assign steps = m.steps.value
  assign mistakes = m.common_mistakes.value
  assign sources = m.sources.value
  assign grind = m.grind.value
  if hub_type == 'machine'
    assign grind = m.recommended_grind.value
  endif
  assign reviewed = m.reviewed_on.value | date: '%d/%m/%Y'
-%}
<article class="section hub" data-theme="cream" aria-labelledby="HubTitle">
  <div class="container">
    {% render 'breadcrumbs' %}
    <header class="hub__head">
      <h1 class="h-display" id="HubTitle">{{ m.name.value }}</h1>
      {%- if hub_type == 'machine' and m.brand.value != blank -%}
        <p class="product__subtitle">{{ m.brand.value }}{% if m.model.value != blank %} {{ m.model.value }}{% endif %}</p>
      {%- endif -%}
      <p class="lead hub__answer">{{ m.short_answer.value }}</p>
      <p class="small muted hub__meta">{{ 'hubs.by' | t: name: byline }}{% if reviewed != blank %} {{ 'hubs.reviewed' | t: date: reviewed }}{% endif %}</p>
    </header>

    <div class="hub__body stack">
      {%- if m.sotocal_recommendation.value != blank -%}
        <section aria-labelledby="HubRec">
          <h2 class="h2" id="HubRec">{{ 'hubs.recommendation' | t }}</h2>
          <div class="rte"><p>{{ m.sotocal_recommendation.value | newline_to_br }}</p></div>
        </section>
      {%- elsif request.design_mode or settings.show_tbc_markers -%}
        <p>{% render 'tbc', note: 'recomendação da Sotocal para este método' %}</p>
      {%- endif -%}

      {%- if blends.size > 0 -%}
        <section aria-labelledby="HubBlends">
          <h2 class="h2" id="HubBlends">{{ 'hubs.blends_heading' | t }}</h2>
          <ul class="tiles" role="list">
            {%- for product in blends limit: 4 -%}
              <li>{% render 'product-tile', product: product, loading: 'lazy', heading: 'h3' %}</li>
            {%- endfor -%}
          </ul>
        </section>
      {%- endif -%}

      {%- if grind != blank or m.dose_ratio.value != blank -%}
        <section aria-labelledby="HubSettings">
          <h2 class="h2" id="HubSettings">{{ 'hubs.settings_heading' | t }}</h2>
          <dl class="fic hub__facts">
            {%- if grind != blank -%}<div><dt>{{ 'hubs.grind' | t }}</dt><dd>{{ grind }}</dd></div>{%- endif -%}
            {%- if m.dose_ratio.value != blank -%}<div><dt>{{ 'hubs.dose' | t }}</dt><dd>{{ m.dose_ratio.value }}</dd></div>{%- endif -%}
          </dl>
        </section>
      {%- endif -%}

      {%- if steps.size > 0 -%}
        <section aria-labelledby="HubSteps">
          <h2 class="h2" id="HubSteps">{{ 'hubs.steps_heading' | t }}</h2>
          <ol class="hub__steps rte">
            {%- for step in steps -%}<li>{{ step }}</li>{%- endfor -%}
          </ol>
        </section>
      {%- endif -%}

      {%- if mistakes.size > 0 -%}
        <section aria-labelledby="HubMistakes">
          <h2 class="h2" id="HubMistakes">{{ 'hubs.mistakes_heading' | t }}</h2>
          <ul class="rte">
            {%- for item in mistakes -%}<li>{{ item }}</li>{%- endfor -%}
          </ul>
        </section>
      {%- endif -%}

      {%- if hub_type == 'machine' -%}
        {%- if m.settings.value != blank -%}
          <section aria-labelledby="HubManual">
            <h2 class="h2" id="HubManual">{{ 'hubs.manual_heading' | t }}</h2>
            <div class="rte"><p>{{ m.settings.value | newline_to_br }}</p></div>
            {%- if sources.size > 0 -%}
              <p class="small muted">{{ 'hubs.sources' | t }}
                {%- for url in sources %} <a class="link" href="{{ url }}" rel="noopener nofollow">{{ url | remove: 'https://' | remove: 'http://' | split: '/' | first }}</a>{% unless forloop.last %},{% endunless %}{%- endfor -%}
              </p>
            {%- endif -%}
          </section>
        {%- endif -%}
        {%- assign parent = m.method.value -%}
        {%- if parent != blank and parent.system.url != blank -%}
          <p><a class="text-link" href="{{ parent.system.url }}">{{ 'hubs.back_to_method' | t: name: parent.name.value }}</a></p>
        {%- endif -%}
      {%- endif -%}

      {%- if hub_type == 'method' -%}
        {%- capture machine_links -%}
          {%- for machine in shop.metaobjects.machine.values -%}
            {%- if machine.method.value.system.handle == m.system.handle and machine.system.url != blank -%}
              {%- comment -%} Link only machine pages that pass the same gate as robots-meta (type pages, or model pages with settings and sources). {%- endcomment -%}
              {%- assign linkable = true -%}
              {%- if machine.brand.value != blank -%}
                {%- if machine.settings.value == blank or machine.sources.value == blank -%}{%- assign linkable = false -%}{%- endif -%}
              {%- endif -%}
              {%- if linkable -%}<li><a class="text-link" href="{{ machine.system.url }}">{{ machine.name.value }}</a></li>{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign machine_links = machine_links | strip -%}
        {%- if machine_links != blank -%}
          <section aria-labelledby="HubMachines">
            <h2 class="h2" id="HubMachines">{{ 'hubs.machines_heading' | t }}</h2>
            <ul class="hub__machines" role="list">{{ machine_links }}</ul>
          </section>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</article>

{%- if faq_items.size > 0 -%}
<section class="section section--tight product-faq" data-theme="ink" aria-labelledby="HubFaq">
  <div class="container grid">
    <h2 class="h2 col-left" id="HubFaq">{{ 'hubs.faq_heading' | t }}</h2>
    <div class="col-right">{% render 'faq-list', items: faq_items, limit: 6 %}</div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main_hub.name",
  "settings": []
}
{% endschema %}
