{%- comment -%}
  HoReCa lead form (brief §9): Shopify contact form with custom fields (labels in the email stay in Portuguese for the
  sales team). Telephone required; consent unticked; honeypot; inline validation in lead-form.js (Postel: accepts
  spaces, dots and +351). Shopify's contact form requires contact[email]; if the visitor leaves it blank, lead-form.js
  fills the shop address so the lead still arrives (ADMIN-SETUP). Success fires horeca_lead_submitted.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'pages.lead.heading' | t
  endif
-%}
<section class="section lead" id="contacto" data-theme="{{ section.settings.theme }}" aria-labelledby="Lead-{{ section.id }}">
  <div class="container grid">
    <div class="col-left">
      <h2 class="h2" id="Lead-{{ section.id }}">{{ heading }}</h2>
      <p class="lead" style="margin-top: 16px">{{ 'pages.lead.intro' | t }}</p>
      <p class="small muted" style="margin-top: 16px">{{ 'pages.lead.or_call' | t }} <a class="link" href="tel:+351226167020">+351 226 167 020</a> <span>{{ 'contact.call_cost' | t }}</span></p>
    </div>
    <div class="col-right">
      {%- assign lead_success = 'pages.lead.success' | t -%}
      {%- form 'contact', id: 'HorecaLead', class: 'lead-form', novalidate: 'novalidate', data-lead-form: '', data-endpoint: settings.lead_endpoint_url, data-success: lead_success -%}
        {%- if form.posted_successfully? -%}
          <div class="form-status" role="status" tabindex="-1" data-lead-success>
            <p class="h3">{{ 'pages.lead.success' | t }}</p>
            <p class="small">{% render 'tbc', note: 'prazo de resposta comercial' %}</p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="form-status" role="alert" tabindex="-1" data-lead-errors>
              <p><strong>{{ 'pages.lead.error_summary' | t }}</strong></p>
              {%- if form.errors contains 'email' -%}<p>{{ 'pages.lead.error_email' | t }}</p>{%- endif -%}
            </div>
          {%- endif -%}
          <input type="hidden" name="contact[Origem]" value="Formulário Profissional ({{ request.locale.iso_code }})">
          <div class="honeypot" aria-hidden="true">
            <label for="LeadWebsite">Website</label>
            <input id="LeadWebsite" type="text" name="contact[website]" tabindex="-1" autocomplete="off">
          </div>
          <div class="lead-form__grid">
            <div class="field">
              <label for="LeadName">{{ 'pages.lead.name' | t }} <span aria-hidden="true">*</span></label>
              <input class="input" id="LeadName" name="contact[Nome]" type="text" autocomplete="name" required aria-describedby="LeadName-error">
              <p class="field-error" id="LeadName-error" hidden></p>
            </div>
            <div class="field">
              <label for="LeadBusiness">{{ 'pages.lead.business' | t }}</label>
              <input class="input" id="LeadBusiness" name="contact[Estabelecimento]" type="text" autocomplete="organization">
            </div>
            <div class="field">
              <label for="LeadType">{{ 'pages.lead.type' | t }}</label>
              <select class="select" id="LeadType" name="contact[Tipo]">
                {%- assign types = 'pages.lead.types' | t | split: '|' -%}
                {%- assign types_pt = 'Café|Pastelaria|Restaurante|Hotel|Bar|Escritório ou empresa|Presentes de empresa|Outro' | split: '|' -%}
                {%- for t in types -%}<option value="{{ types_pt[forloop.index0] }}">{{ t }}</option>{%- endfor -%}
              </select>
            </div>
            <div class="field">
              <label for="LeadTown">{{ 'pages.lead.town' | t }}</label>
              <input class="input" id="LeadTown" name="contact[Localidade]" type="text" autocomplete="address-level2">
            </div>
            <div class="field">
              <label for="LeadDistrict">{{ 'pages.lead.district' | t }}</label>
              <select class="select" id="LeadDistrict" name="contact[Distrito]">
                <option value="">{{ 'pages.lead.district_choose' | t }}</option>
                {%- assign districts = 'pages.lead.districts' | t | split: '|' -%}
                {%- assign districts_pt = 'Aveiro|Beja|Braga|Bragança|Castelo Branco|Coimbra|Évora|Faro|Guarda|Leiria|Lisboa|Portalegre|Porto|Santarém|Setúbal|Viana do Castelo|Vila Real|Viseu|Região Autónoma dos Açores|Região Autónoma da Madeira' | split: '|' -%}
                {%- for d in districts -%}<option value="{{ districts_pt[forloop.index0] }}"{% if metaobject.district.value == districts_pt[forloop.index0] %} selected{% endif %}>{{ d }}</option>{%- endfor -%}
              </select>
            </div>
            <div class="field">
              <label for="LeadPhone">{{ 'pages.lead.phone' | t }} <span aria-hidden="true">*</span></label>
              <input class="input" id="LeadPhone" name="contact[Telefone]" type="tel" inputmode="tel" autocomplete="tel" required aria-describedby="LeadPhone-hint LeadPhone-error">
              <p class="hint" id="LeadPhone-hint">{{ 'pages.lead.phone_hint' | t }}</p>
              <p class="field-error" id="LeadPhone-error" hidden></p>
            </div>
            <div class="field">
              <label for="LeadEmail">{{ 'pages.lead.email' | t }}</label>
              <input class="input" id="LeadEmail" name="contact[email]" type="email" autocomplete="email" inputmode="email" aria-describedby="LeadEmail-error">
              <p class="field-error" id="LeadEmail-error" hidden></p>
            </div>
            <div class="field">
              <label for="LeadSupplier">{{ 'pages.lead.supplier' | t }}</label>
              <input class="input" id="LeadSupplier" name="contact[Fornecedor atual]" type="text">
            </div>
            <div class="field">
              <label for="LeadVolume">{{ 'pages.lead.volume' | t }}</label>
              <select class="select" id="LeadVolume" name="contact[Consumo mensal]">
                {%- assign vols = 'pages.lead.volumes' | t | split: '|' -%}
                {%- assign vols_pt = 'Até 10 kg|10–30 kg|30–60 kg|Mais de 60 kg|Não sei' | split: '|' -%}
                {%- for v in vols -%}<option value="{{ vols_pt[forloop.index0] }}"{% if forloop.last %} selected{% endif %}>{{ v }}</option>{%- endfor -%}
              </select>
            </div>
          </div>
          <fieldset class="radio-pills lead-form__time">
            <legend class="label">{{ 'pages.lead.best_time' | t }}</legend>
            {%- assign times = 'pages.lead.times' | t | split: '|' -%}
            {%- assign times_pt = 'Manhã|Tarde|Indiferente' | split: '|' -%}
            {%- for t in times -%}
              <label class="radio-pill"><input type="radio" name="contact[Melhor hora]" value="{{ times_pt[forloop.index0] }}"{% if forloop.last %} checked{% endif %}><span>{{ t }}</span></label>
            {%- endfor -%}
          </fieldset>
          <div class="field">
            <label for="LeadMessage">{{ 'pages.lead.message' | t }}</label>
            <textarea class="textarea" id="LeadMessage" name="contact[body]" rows="4"></textarea>
          </div>
          <label class="checkbox">
            <input type="checkbox" name="contact[Consentimento]" value="Sim" required aria-describedby="LeadConsent-error" id="LeadConsent">
            <span>{{ 'pages.lead.consent_html' | t: privacy_url: shop.privacy_policy.url }}</span>
          </label>
          <p class="field-error" id="LeadConsent-error" hidden></p>
          <button class="btn btn--primary" type="submit" style="margin-top: 24px">{{ 'pages.lead.submit' | t }}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>
<script src="{{ 'lead-form.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.lead_form.name",
  "settings": [
    { "type": "select", "id": "theme", "label": "t:settings.theme", "default": "cream", "options": [ { "value": "cream", "label": "t:settings.cream" }, { "value": "ink", "label": "t:settings.ink" } ] },
    { "type": "text", "id": "heading", "label": "t:settings.heading", "info": "t:settings.blank_uses_default" }
  ],
  "presets": [{ "name": "t:sections.lead_form.name" }]
}
{% endschema %}
