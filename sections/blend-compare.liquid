{%- comment -%}
  Blend comparison table (brief §8). Rows come from a collection (default "cafe"); €/kg uses the 1 kg variant when present,
  so shoppers can compare with supermarket prices (brief §1). A real table with a caption and row headers.
{%- endcomment -%}
{%- liquid
  assign col = section.settings.collection | default: collections['cafe']
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'product.compare_heading' | t
  endif
-%}
{%- if col.products.size > 1 -%}
<section class="section section--tight compare" data-theme="cream" aria-labelledby="Compare-{{ section.id }}">
  <div class="container">
    <h2 class="h2" id="Compare-{{ section.id }}">{{ heading }}</h2>
    <div class="compare__scroll" role="region" aria-labelledby="Compare-{{ section.id }}" tabindex="0">
      <table class="compare__table">
        <caption class="visually-hidden">{{ 'product.compare_caption' | t }}</caption>
        <thead>
          <tr>
            <th scope="col">{{ 'product.compare_blend' | t }}</th>
            <th scope="col">{{ 'product.compare_character' | t }}</th>
            <th scope="col">{{ 'product.intensity' | t }}</th>
            <th scope="col">{{ 'home.blends.ideal_for' | t }}</th>
            <th scope="col">{{ 'product.compare_per_kg' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for p in col.products limit: 6 -%}
            {%- liquid
              assign m = p.metafields.sotocal
              assign kg = nil
              for v in p.variants
                if v.options contains '1 kg' and kg == nil
                  assign kg = v
                endif
              endfor
              if kg == nil
                assign kg = p.selected_or_first_available_variant
              endif
            -%}
            <tr{% if p.id == product.id %} aria-current="true" class="is-current"{% endif %}>
              <th scope="row"><a href="{{ p.url }}">{{ p.title }}</a></th>
              <td>{{ m.character.value | default: '–' }}</td>
              <td class="tabular">{% if m.intensity != blank %}{{ m.intensity.value }}/5{% else %}{% render 'tbc', note: 'intensidade' %}{% endif %}</td>
              <td>{% if m.best_for != blank %}{{ m.best_for.value | join: ', ' }}{% else %}{% render 'tbc', note: 'ideal para' %}{% endif %}</td>
              <td class="tabular">{% render 'unit-price', variant: kg %}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.compare.name",
  "enabled_on": { "templates": ["product", "collection", "page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "t:settings.heading", "info": "t:settings.blank_uses_default" },
    { "type": "collection", "id": "collection", "label": "t:sections.compare.collection" }
  ]
}
{% endschema %}
