{%- comment -%}
  Product page (brief §8). Conventional layout (Jakob): gallery left, buy box right; price + €/kg + "IVA incluído" grouped;
  purchase type "Compra única" or subscription (never pre-selected, §9); FIC food information visible before purchase
  (EU 1169/2011 art. 14); sticky add-to-cart bar on mobile (Fitts). Variant data for product.js is pre-formatted here.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign m = product.metafields.sotocal
  assign form_id = 'ProductForm-' | append: section.id
  assign layout = section.settings.layout
  assign has_plans = false
  if section.settings.show_subscription and product.selling_plan_groups.size > 0
    assign has_plans = true
  endif
  assign subtitle = m.subtitle.value
  if subtitle == blank and layout == 'coffee'
    assign subtitle = 'product.coffee_subtitle' | t
  endif
-%}
<section class="section product" data-theme="cream" data-product-section aria-labelledby="ProductTitle-{{ section.id }}">
  <div class="container">
    {% render 'breadcrumbs' %}
    <div class="product__grid">
      <div class="product__gallery" data-gallery>
        <ul class="product__media" role="list" aria-label="{{ 'product.gallery' | t: title: product.title }}">
          {%- for media in product.media -%}
            {%- assign alt = media.alt | default: product.title -%}
            <li class="product__media-item media-plane" id="Media-{{ section.id }}-{{ forloop.index }}">
              {%- if forloop.first -%}
                {{ media.preview_image | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 1024px) 50vw, 92vw', alt: alt, loading: 'eager', fetchpriority: 'high', class: 'product__img' }}
              {%- else -%}
                {{ media.preview_image | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 1024px) 25vw, 92vw', alt: alt, loading: 'lazy', class: 'product__img' }}
              {%- endif -%}
              <span class="contact-shadow" aria-hidden="true"></span>
            </li>
          {%- else -%}
            <li class="product__media-item media-plane">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</li>
          {%- endfor -%}
        </ul>
        {%- if layout == 'coffee' and product.media.size < 4 -%}
          <p class="small">{% render 'tbc', note: 'fotografias: verso da embalagem com a informação alimentar, grão em macro, café em uso' %}</p>
        {%- endif -%}
      </div>

      <div class="product__info">
        <div class="product__head">
          <h1 class="h-display product__title" id="ProductTitle-{{ section.id }}">{{ product.title }}</h1>
          {%- if subtitle != blank -%}<p class="product__subtitle">{{ subtitle }}</p>{%- endif -%}
        </div>
        {%- if m.character != blank -%}<p class="lead product__character">{{ m.character.value }}</p>{%- endif -%}

        {%- liquid
          assign methods = m.recommended_methods.value
          assign show_fit = false
          if m.best_for != blank
            assign show_fit = true
          endif
          if methods.size > 0
            assign show_fit = true
          endif
        -%}
        {%- if show_fit -%}
          <div class="product__fit">
            {%- if m.best_for != blank -%}
              <p><span class="label">{{ 'product.ideal_for' | t }}</span> {{ m.best_for.value | join: ', ' }}</p>
            {%- endif -%}
            {%- if methods.size > 0 -%}
              <p>
                <span class="label">{{ 'product.methods_label' | t }}</span>
                {%- for method in methods %} {% if method.system.url != blank %}<a class="text-link" href="{{ method.system.url }}">{{ method.name.value }}</a>{% else %}{{ method.name.value }}{% endif %}{% unless forloop.last %},{% endunless %}{%- endfor -%}
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if layout == 'coffee' and section.settings.show_intensity and m.intensity == blank and settings.show_tbc_markers != true and request.design_mode != true -%}
          {%- comment -%} No intensity value yet and the TBC markers are off: show no empty label. {%- endcomment -%}
        {%- elsif layout == 'coffee' and section.settings.show_intensity -%}
          <div class="product__intensity">
            <span class="label">{{ 'product.intensity' | t }}</span>
            {%- if m.intensity != blank -%}
              {%- assign level = m.intensity.value -%}
              <span class="intensity" role="img" aria-label="{{ 'product.intensity_value' | t: value: level }}">
                {%- for i in (1..5) -%}<span class="intensity__dot{% if i <= level %} is-on{% endif %}"></span>{%- endfor -%}
              </span>
            {%- else -%}
              {% render 'tbc', note: 'intensidade 1–5' %}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if m.tasting_notes != blank -%}
          <ul class="chips" role="list" aria-label="{{ 'product.characteristics' | t }}">
            {%- for note in m.tasting_notes.value -%}<li class="chip">{{ note }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if settings.catalogue_only -%}
          <div class="product__catalogue stack">
            <p class="h3">{{ 'product.catalogue_heading' | t }}</p>
            <p>{{ 'product.catalogue_text' | t }}</p>
            {%- unless product.has_only_default_variant -%}
              <p class="small"><strong>{{ 'product.catalogue_formats' | t }}</strong>
                {%- for option in product.options_with_values %} {{ option.name }}: {{ option.values | join: ', ' }}{% unless forloop.last %};{% endunless %}{%- endfor -%}
              </p>
            {%- endunless -%}
            <a class="btn btn--primary" href="{% if routes.root_url != '/' %}{{ routes.root_url }}{% endif %}/pages/contactos">{{ 'product.catalogue_cta' | t }}</a>
          </div>
        {%- else -%}
        {%- form 'product', product, id: form_id, class: 'buy-form', novalidate: 'novalidate', data-cart-add: '', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="radio-pills" data-option-index="{{ forloop.index0 }}">
                <legend class="label">{{ option.name }}</legend>
                {%- for value in option.values -%}
                  <label class="radio-pill">
                    <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-option-value{% if option.selected_value == value %} checked{% endif %}>
                    <span>{{ value }}</span>
                  </label>
                {%- endfor -%}
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}

          {%- if has_plans -%}
            <fieldset class="purchase-type" data-purchase-type>
              <legend class="label">{{ 'product.purchase_type' | t }}</legend>
              <label class="purchase-type__option">
                <input type="radio" name="selling_plan" value="" {% unless product.requires_selling_plan %}checked{% endunless %} data-selling-plan>
                <span><strong>{{ 'product.one_time' | t }}</strong></span>
              </label>
              {%- for group in product.selling_plan_groups -%}
                {%- for plan in group.selling_plans -%}
                  <label class="purchase-type__option">
                    <input type="radio" name="selling_plan" value="{{ plan.id }}" data-selling-plan>
                    <span>
                      <strong>{{ 'product.subscription' | t }}: {{ plan.name }}</strong>
                      {%- if plan.price_adjustments.size > 0 -%}
                        {%- assign adj = plan.price_adjustments.first -%}
                        {%- if adj.value_type == 'percentage' -%}<span class="small muted"> {{ 'product.saves_percent' | t: value: adj.value }}</span>{%- endif -%}
                      {%- else -%}
                        <span class="small"> {% render 'tbc', note: 'desconto da subscrição' %}</span>
                      {%- endif -%}
                    </span>
                  </label>
                {%- endfor -%}
              {%- endfor -%}
              <p class="small muted">{{ 'product.subscription_terms' | t }} {% render 'tbc', note: 'termos e desconto da subscrição' %}</p>
            </fieldset>
          {%- endif -%}

          {%- if product.tags contains 'presente' -%}
            <div class="field gift-message">
              <label for="GiftMessage-{{ section.id }}">{{ 'product.gift_message_label' | t }}</label>
              <textarea class="textarea" id="GiftMessage-{{ section.id }}" name="properties[{{ 'product.gift_message' | t }}]" maxlength="200" rows="3" aria-describedby="GiftMessageHint-{{ section.id }}"></textarea>
              <span class="hint" id="GiftMessageHint-{{ section.id }}">{{ 'product.gift_message_hint' | t }} {% render 'tbc', note: 'como a mensagem chega ao destinatário (cartão impresso ou nota na encomenda)' %}</span>
            </div>
          {%- endif -%}

          {% render 'price', product: product, variant: current_variant, size: 'lg', id: 'Price' %}

          <div class="buy-form__row">
            <div class="qty">
              <button type="button" data-qty-step="-1" aria-label="{{ 'product.qty_decrease' | t }}">{% render 'icon', name: 'minus', class: 'icon--sm' %}</button>
              <label class="visually-hidden" for="Qty-{{ section.id }}">{{ 'product.quantity' | t }}</label>
              <input id="Qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric" data-qty>
              <button type="button" data-qty-step="1" aria-label="{{ 'product.qty_increase' | t }}">{% render 'icon', name: 'plus', class: 'icon--sm' %}</button>
            </div>
            <button class="btn btn--primary buy-form__submit" type="submit" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
              <span data-add-label>{% if current_variant.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</span>
            </button>
          </div>
        {%- endform -%}

        {%- comment -%}
          "Avise-me" for sold-out sizes (the page stays live, schema says OutOfStock). A contact form, not a marketing signup:
          the email is used once, for this notice. product.js shows or hides the block as the variant changes.
          Interim: the message lands in the shop inbox until a back-in-stock app is chosen.
        {%- endcomment -%}
        {%- assign notify_body = 'product.notify_body' | t: product: product.title -%}
        {%- unless product.has_only_default_variant -%}
          {%- assign notify_options = current_variant.options | join: ' / ' -%}
          {%- assign notify_value = notify_body | append: ' (' | append: notify_options | append: ')' -%}
        {%- endunless -%}
        <div class="notify" id="Notify-{{ section.id }}" data-notify{% if current_variant.available %} hidden{% endif %}>
          {%- form 'contact', id: 'NotifyForm', class: 'notify__form', novalidate: 'novalidate' -%}
            {%- if form.posted_successfully? -%}
              <p class="form-status" role="status" tabindex="-1" data-notify-success>{{ 'product.notify_success' | t }}</p>
            {%- else -%}
              <h2 class="notify__title">{{ 'product.notify_heading' | t }}</h2>
              <p class="small muted">{{ 'product.notify_text' | t }} {% render 'tbc', note: 'avise-me: app de reposição de stock ou envio manual pela Sotocal' %}</p>
              <input type="hidden" name="contact[Produto]" value="{{ product.url | prepend: shop.url }}">
              <input type="hidden" name="contact[body]" value="{{ notify_value | default: notify_body }}" data-notify-body data-base="{{ notify_body | escape }}">
              <label class="visually-hidden" for="NotifyEmail-{{ section.id }}">{{ 'product.notify_email' | t }}</label>
              <input class="input" id="NotifyEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" inputmode="email" required placeholder="{{ 'product.notify_email' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="NotifyError-{{ section.id }}"{% endif %}>
              <label class="checkbox">
                <input type="checkbox" name="contact[Consentimento]" value="sim" required>
                <span>{{ 'product.notify_consent' | t }}</span>
              </label>
              {%- if form.errors -%}<p class="field-error" id="NotifyError-{{ section.id }}" role="alert">{{ 'product.notify_error' | t }}</p>{%- endif -%}
              <button class="btn btn--outline" type="submit">{{ 'product.notify_submit' | t }}</button>
            {%- endif -%}
          {%- endform -%}
        </div>

        <ul class="product__promises" role="list">
          <li>{% render 'icon', name: 'truck', class: 'icon--sm' %}<span>{{ 'product.delivery' | t }} {% render 'tbc', note: 'prazo de entrega' %}</span></li>
          {%- if product.tags contains 'presente' -%}
            {%- capture season_raw -%}{% render 'gift-season-on' %}{%- endcapture -%}
            {%- assign in_gift_season = season_raw | strip -%}
            {%- if in_gift_season == 'true' -%}<li class="gift-cutoffs">{% render 'icon', name: 'truck', class: 'icon--sm' %}<span>{% render 'gift-cutoffs' %}</span></li>{%- endif -%}
          {%- endif -%}
          {%- case m.roast_date_policy.value -%}
            {%- when 'impressa-na-embalagem' -%}
              <li>{% render 'icon', name: 'cup', class: 'icon--sm' %}<span>{{ 'product.roast_date_printed' | t }}</span></li>
            {%- when 'torrado-na-semana-do-envio' -%}
              <li>{% render 'icon', name: 'cup', class: 'icon--sm' %}<span>{{ 'product.roast_date_week' | t }}</span></li>
            {%- when 'torrado-por-encomenda' -%}
              <li>{% render 'icon', name: 'cup', class: 'icon--sm' %}<span>{{ 'product.roast_date_order' | t }}</span></li>
          {%- endcase -%}
          {%- capture pickup_raw -%}{% render 'cafe-count', pickup: true %}{%- endcapture -%}
          {%- assign pickup_n = pickup_raw | plus: 0 -%}
          {%- if settings.pickup_enabled and pickup_n > 0 -%}
            <li>{% render 'icon', name: 'cup', class: 'icon--sm' %}<a class="link" href="{% if routes.root_url != '/' %}{{ routes.root_url }}{% endif %}/pages/levantar-no-cafe">{{ 'product.pickup_link' | t }}</a></li>
          {%- endif -%}
        </ul>
        {%- endif -%}

        <div class="accordion product__accordions">
          {%- if product.description != blank -%}
            <details class="accordion__item" open>
              <summary>{{ 'product.tab_description' | t }}<span class="pm" aria-hidden="true"></span></summary>
              <div class="accordion__body rte">{{ product.description }}</div>
            </details>
          {%- endif -%}
          {%- if layout == 'substitute' and m.substitute.value != blank -%}
            <div class="product__substitute">{% render 'substitute-facts', substitute: m.substitute.value %}</div>
          {%- endif -%}
          {%- if layout == 'coffee' -%}
            <details class="accordion__item">
              <summary>{{ 'product.tab_origins' | t }}<span class="pm" aria-hidden="true"></span></summary>
              <div class="accordion__body rte">
                {%- if m.origins != blank -%}<p>{{ m.origins.value | newline_to_br }}</p>{%- endif -%}
                {%- if m.roast != blank -%}<p><strong>{{ 'product.roast' | t }}:</strong> {{ m.roast.value }}</p>{%- endif -%}
                <p><strong>{{ 'product.arabica_robusta' | t }}:</strong> {% if m.arabica_robusta != blank %}{{ m.arabica_robusta.value }}{% else %}{% render 'tbc', note: 'proporção arábica/robusta' %}{% endif %}</p>
              </div>
            </details>
            <details class="accordion__item">
              <summary>{{ 'product.tab_prepare' | t }}<span class="pm" aria-hidden="true"></span></summary>
              <div class="accordion__body rte">
                {%- if m.preparation != blank -%}{{ m.preparation.value | newline_to_br }}{%- else -%}{{ 'product.prepare_default_html' | t }} {% render 'tbc', note: 'conselhos para cafeteira e máquina automática' %}{%- endif -%}
              </div>
            </details>
          {%- elsif m.preparation != blank -%}
            <details class="accordion__item">
              <summary>{{ 'product.tab_use' | t }}<span class="pm" aria-hidden="true"></span></summary>
              <div class="accordion__body rte">{{ m.preparation.value | newline_to_br }}</div>
            </details>
          {%- endif -%}
          <details class="accordion__item"{% if section.settings.fic_open %} open{% endif %}>
            <summary>{{ 'product.tab_food_info' | t }}<span class="pm" aria-hidden="true"></span></summary>
            <div class="accordion__body">{% render 'fic-table', product: product %}</div>
          </details>
          {%- unless settings.catalogue_only -%}
          <details class="accordion__item">
            <summary>{{ 'product.tab_shipping' | t }}<span class="pm" aria-hidden="true"></span></summary>
            <div class="accordion__body rte">{{ 'product.shipping_returns_html' | t: refund_url: shop.refund_policy.url }}</div>
          </details>
          {%- endunless -%}
        </div>
      </div>
    </div>
  </div>

  {%- unless settings.catalogue_only -%}
  <div class="sticky-atc" data-sticky-atc hidden>
    <div class="sticky-atc__info">
      <span class="sticky-atc__title">{{ product.title }}</span>
      <span class="tabular" data-sticky-price>{{ current_variant.price | money }}</span>
    </div>
    <button class="btn btn--primary" type="submit" form="{{ form_id }}" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
      <span data-add-label>{% if current_variant.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</span>
    </button>
  </div>

  <script type="application/json" data-product-json>
    {
      "url": {{ product.url | json }},
      "variants": [
        {%- for v in product.variants -%}
          {%- capture unit -%}{% render 'unit-price', variant: v, plain: true %}{%- endcapture -%}
          {
            "id": {{ v.id }}, "options": {{ v.options | json }}, "available": {{ v.available | json }},
            "price": {{ v.price | money | json }}, "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
            "unit": {{ unit | strip | json }},
            "plans": {
              {%- for a in v.selling_plan_allocations -%}
                {%- capture punit -%}{% render 'unit-price', variant: v, price: a.price, plain: true %}{%- endcapture -%}
                {{ a.selling_plan.id | append: '' | json }}: { "price": {{ a.price | money | json }}, "unit": {{ punit | strip | json }} }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
  {%- endunless -%}
</section>
{%- unless settings.catalogue_only -%}<script src="{{ 'product.js' | asset_url }}" defer></script>{%- endunless -%}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "class": "section-main-product",
  "settings": [
    { "type": "select", "id": "layout", "label": "t:sections.main_product.layout", "default": "coffee", "options": [
      { "value": "coffee", "label": "t:sections.main_product.layout_coffee" },
      { "value": "spice", "label": "t:sections.main_product.layout_spice" },
      { "value": "substitute", "label": "t:sections.main_product.layout_substitute" },
      { "value": "simple", "label": "t:sections.main_product.layout_simple" },
      { "value": "bundle", "label": "t:sections.main_product.layout_bundle" } ] },
    { "type": "checkbox", "id": "show_subscription", "label": "t:sections.main_product.show_subscription", "default": true },
    { "type": "checkbox", "id": "show_intensity", "label": "t:sections.main_product.show_intensity", "default": true },
    { "type": "checkbox", "id": "fic_open", "label": "t:sections.main_product.fic_open", "default": false }
  ]
}
{% endschema %}
