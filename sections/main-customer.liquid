{%- comment -%}
  Classic customer account pages (fallback only, DECISIONS D25). Shopify's current customer accounts are hosted and
  styled in admin; these templates keep the theme tidy if the store switches to classic accounts.
{%- endcomment -%}
<section class="section customer" data-theme="cream" aria-labelledby="CustomerTitle">
  <div class="container customer__inner stack">
    {%- case section.settings.view -%}
      {%- when 'login' -%}
        <h1 class="h-display" id="CustomerTitle">{{ 'customer.login_title' | t }}</h1>
        {%- form 'customer_login', class: 'stack' -%}
          {%- if form.errors -%}<div class="form-status" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="field"><label for="LoginEmail">{{ 'customer.email' | t }}</label><input class="input" id="LoginEmail" type="email" name="customer[email]" autocomplete="email" required></div>
          <div class="field"><label for="LoginPassword">{{ 'customer.password' | t }}</label><input class="input" id="LoginPassword" type="password" name="customer[password]" autocomplete="current-password" required></div>
          <button class="btn btn--primary" type="submit">{{ 'customer.sign_in' | t }}</button>
        {%- endform -%}
        <p><a class="link" href="{{ routes.account_register_url }}">{{ 'customer.create' | t }}</a></p>
      {%- when 'register' -%}
        <h1 class="h-display" id="CustomerTitle">{{ 'customer.register_title' | t }}</h1>
        {%- form 'create_customer', class: 'stack' -%}
          {%- if form.errors -%}<div class="form-status" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="field"><label for="RegFirst">{{ 'customer.first_name' | t }}</label><input class="input" id="RegFirst" name="customer[first_name]" autocomplete="given-name"></div>
          <div class="field"><label for="RegLast">{{ 'customer.last_name' | t }}</label><input class="input" id="RegLast" name="customer[last_name]" autocomplete="family-name"></div>
          <div class="field"><label for="RegEmail">{{ 'customer.email' | t }}</label><input class="input" id="RegEmail" type="email" name="customer[email]" autocomplete="email" required></div>
          <div class="field"><label for="RegPassword">{{ 'customer.password' | t }}</label><input class="input" id="RegPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
          <button class="btn btn--primary" type="submit">{{ 'customer.create' | t }}</button>
        {%- endform -%}
      {%- else -%}
        <h1 class="h-display" id="CustomerTitle">{{ 'header.account' | t }}</h1>
        {%- if customer -%}
          <p>{{ customer.name }} ({{ customer.email }})</p>
          <h2 class="h3">{{ 'customer.orders' | t }}</h2>
          {%- if customer.orders.size > 0 -%}
            <ul class="hairlines" role="list">{%- for order in customer.orders -%}<li><a class="link" href="{{ order.customer_url }}">{{ order.name }}</a>, {{ order.created_at | date: '%d/%m/%Y' }}, {{ order.total_price | money }}</li>{%- endfor -%}</ul>
          {%- else -%}<p>{{ 'customer.no_orders' | t }}</p>{%- endif -%}
          <p><a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a></p>
        {%- endif -%}
    {%- endcase -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_customer.name",
  "settings": [ { "type": "select", "id": "view", "label": "t:sections.main_customer.view", "default": "account", "options": [ { "value": "login", "label": "Login" }, { "value": "register", "label": "Register" }, { "value": "account", "label": "Account" } ] } ]
}
{% endschema %}
