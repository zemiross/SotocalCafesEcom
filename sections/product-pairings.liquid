{%- comment -%} "Combina com" (brief §8): products from sotocal.pairings, else a chosen collection. Internal linking blends ↔ spices. {%- endcomment -%}
{%- liquid
  assign items = product.metafields.sotocal.pairings.value
  if items == blank and section.settings.collection != blank
    assign items = section.settings.collection.products
  endif
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'product.pairings_heading' | t
  endif
-%}
{%- if items.size > 0 -%}
<section class="section section--tight pairings" data-theme="cream" aria-labelledby="Pairings-{{ section.id }}">
  <div class="container">
    <h2 class="h2" id="Pairings-{{ section.id }}" style="margin-bottom: 48px">{{ heading }}</h2>
    <ul class="tiles tiles--3" role="list">
      {%- assign shown = 0 -%}
      {%- for p in items -%}
        {%- if p.id != product.id and shown < 3 -%}
          {%- assign shown = shown | plus: 1 -%}
          <li>{% render 'product-tile', product: p %}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.pairings.name",
  "enabled_on": { "templates": ["product", "article"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "t:settings.heading", "info": "t:settings.blank_uses_default" },
    { "type": "collection", "id": "collection", "label": "t:sections.pairings.collection", "info": "t:sections.pairings.collection_info" }
  ]
}
{% endschema %}
