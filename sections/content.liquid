{%- comment -%} Flexible content section built from theme blocks (heading, text, button, image, quote). {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="section section--tight content-section" data-theme="{{ section.settings.theme }}">
  <div class="container"><div class="stack content-section__inner">{% content_for 'blocks' %}</div></div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.content.name",
  "settings": [
    { "type": "select", "id": "theme", "label": "t:settings.theme", "default": "cream", "options": [ { "value": "cream", "label": "t:settings.cream" }, { "value": "ink", "label": "t:settings.ink" } ] }
  ],
  "blocks": [{ "type": "@theme" }],
  "presets": [{ "name": "t:sections.content.name" }]
}
{% endschema %}
