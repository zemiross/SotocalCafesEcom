{%- comment -%}
  Fold 3, four blends (cream). Desktop with motion: pinned for 4 × 70vh, one blend at a time (Hick), packshot crossfades
  with a 6° settle and 24 px travel, details swap with a mask reveal, four named progress buttons.
  Mobile: horizontal scroll-snap carousel (84vw cards). No JS: all four stacked. All blends stay in the DOM in order.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'home.blends.heading' | t
  endif
  assign intro = section.settings.intro
  if intro == blank
    assign intro = 'home.blends.intro' | t
  endif
  assign link_label = section.settings.link_label
  if link_label == blank
    assign link_label = 'home.blends.all' | t
  endif
  if routes.root_url == '/'
    assign prefix = ''
  else
    assign prefix = routes.root_url
  endif
  assign link_url = section.settings.link_url
  if link_url == blank
    assign link_url = prefix | append: '/collections/cafe'
  endif
-%}
<section class="section blends" data-theme="cream" data-motion="blends" id="lotes" aria-labelledby="BlendsTitle-{{ section.id }}"
         style="--steps: {{ section.blocks.size }}; --step-vh: {{ section.settings.step_vh }};">
  {% render 'stream' %}
  <div class="blends__pin" data-blends-pin>
    <div class="container grid blends__grid">
      <header class="blends__head">
        <h2 class="h2" id="BlendsTitle-{{ section.id }}">{{ heading }}</h2>
        <p class="blends__intro">{{ intro }}</p>
      </header>

      <div class="blends__list" data-blends-list>
        {%- for block in section.blocks -%}
          {%- liquid
            assign p = block.settings.product
            assign key = block.settings.fallback
            assign tkey = 'home.blends.' | append: key
            assign name = block.settings.title
            if name == blank and p != blank
              assign name = p.title | remove: 'Lote ' | remove: 'Café '
            endif
            if name == blank
              assign name = tkey | append: '.name' | t
            endif
            assign character = block.settings.character
            if character == blank and p.metafields.sotocal.character != blank
              assign character = p.metafields.sotocal.character.value
            endif
            if character == blank
              assign character = tkey | append: '.character' | t
            endif
            assign chips = block.settings.chips | split: ','
            if chips.size == 0 and p.metafields.sotocal.tasting_notes != blank
              assign chips = p.metafields.sotocal.tasting_notes.value
            endif
            if chips.size == 0
              assign chips = tkey | append: '.chips' | t | split: ','
            endif
            assign ideal = block.settings.ideal_for
            if ideal == blank and p.metafields.sotocal.best_for != blank
              assign ideal = p.metafields.sotocal.best_for.value | join: ', '
            endif
            assign img = block.settings.image | default: p.featured_image
            assign fallback_img = 'lote-' | append: key | append: '.webp'
            if p != blank
              assign view_url = p.url
            else
              assign view_url = prefix | append: '/products/' | append: block.settings.fallback_handle
            endif
          -%}
          <article class="blend" id="Blend-{{ block.id }}" data-blend data-index="{{ forloop.index0 }}" aria-labelledby="BlendName-{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="blend__text">
              <h3 class="h3 blend__name" id="BlendName-{{ block.id }}">{{ name }}</h3>
              <p class="blend__char">{{ character }}</p>
              <ul class="chips" role="list" aria-label="{{ 'product.characteristics' | t }}">
                {%- for chip in chips -%}
                  {%- assign c = chip | strip -%}
                  {%- if c == '[[TBC]]' -%}<li>{% render 'tbc', note: 'descritores do Descafeinado' %}</li>{%- elsif c != blank -%}<li class="chip">{{ c }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>
              {%- if ideal != blank or settings.show_tbc_markers or request.design_mode -%}
              <p class="blend__ideal">
                <span class="blend__ideal-label">{{ 'home.blends.ideal_for' | t }}</span>
                {% if ideal != blank %}{{ ideal }}{% else %}{% render 'tbc', note: 'ideal para' %}{% endif %}
              </p>
              {%- endif -%}
              {%- if p != blank -%}
                {% render 'price', product: p, show_from: true %}
                <div class="blend__actions">
                  {%- if settings.catalogue_only -%}
                    <a class="btn btn--outline" href="{{ view_url }}">{{ 'home.blends.view' | t }}<span class="visually-hidden">: {{ name }}</span></a>
                  {%- else -%}
                  {%- assign fv = p.selected_or_first_available_variant -%}
                  {%- form 'product', p, class: 'blend__form', data-cart-add: '' -%}
                    <input type="hidden" name="id" value="{{ fv.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button class="btn btn--primary" type="submit"{% unless fv.available %} disabled{% endunless %}
                            aria-describedby="BlendVariant-{{ block.id }}">
                      {%- if fv.available -%}{{ 'product.add_to_cart' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
                    </button>
                    <p class="blend__variant small muted" id="BlendVariant-{{ block.id }}">{{ 'home.blends.adds' | t: variant: fv.title }}</p>
                  {%- endform -%}
                  <a class="text-link" href="{{ view_url }}">{{ 'home.blends.view' | t }}<span class="visually-hidden">: {{ name }}</span></a>
                  {%- endif -%}
                </div>
              {%- else -%}
                <p class="price"><span class="price__current">{% render 'tbc', note: 'preço desde x,xx €' %}</span> <span class="unit-price">{% render 'tbc', note: 'x,xx €/kg' %}</span> <span class="price__tax">{{ 'product.tax_included' | t }}</span></p>
                <div class="blend__actions">
                  <a class="text-link" href="{{ view_url }}">{{ 'home.blends.view' | t }}<span class="visually-hidden">: {{ name }}</span></a>
                </div>
              {%- endif -%}
            </div>
            <div class="blend__media" data-blend-media>
              <div class="blend__plane">
                {%- if img != blank -%}
                  {{ img | image_url: width: 1000 | image_tag: widths: '360, 540, 720, 1000', sizes: '(min-width: 1024px) 36vw, 76vw', loading: 'lazy', alt: name, class: 'blend__img' }}
                {%- else -%}
                  <img class="blend__img" src="{{ fallback_img | asset_url }}" alt="{{ 'home.blends.packshot_alt' | t: name: name }}" width="720" height="642" loading="lazy" decoding="async">
                {%- endif -%}
                <span class="contact-shadow" aria-hidden="true"></span>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>

      <div class="blends__steps" role="group" aria-label="{{ 'home.blends.steps_label' | t }}" data-blends-steps>
        {%- for block in section.blocks -%}
          {%- liquid
            assign p = block.settings.product
            assign name = block.settings.title
            if name == blank and p != blank
              assign name = p.title | remove: 'Lote ' | remove: 'Café '
            endif
            if name == blank
              assign step_key = 'home.blends.' | append: block.settings.fallback | append: '.name'
              assign name = step_key | t
            endif
          -%}
          <button class="blends__step" type="button" data-blend-step="{{ forloop.index0 }}" aria-controls="Blend-{{ block.id }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
            <span class="blends__step-bar" aria-hidden="true"><span></span></span>
            {{ name }}
          </button>
        {%- endfor -%}
      </div>

      <p class="blends__all"><a class="text-link" href="{{ link_url }}">{{ link_label }}</a></p>
    </div>
  </div>
</section>

<script src="{{ 'stream.js' | asset_url }}" defer></script>
<script src="{{ 'blends.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.blends.name",
  "class": "section-home-blends",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:settings.heading", "info": "t:settings.blank_uses_default" },
    { "type": "textarea", "id": "intro", "label": "t:settings.text", "info": "t:settings.blank_uses_default" },
    { "type": "text", "id": "link_label", "label": "t:settings.link_label", "info": "t:settings.blank_uses_default" },
    { "type": "url", "id": "link_url", "label": "t:settings.link_url" },
    { "type": "range", "id": "step_vh", "label": "t:sections.blends.step_vh", "min": 40, "max": 120, "step": 5, "unit": "vh", "default": 70 }
  ],
  "blocks": [
    {
      "type": "blend",
      "name": "t:sections.blends.blend",
      "settings": [
        { "type": "product", "id": "product", "label": "t:sections.blends.product" },
        { "type": "select", "id": "fallback", "label": "t:sections.blends.fallback", "default": "super-milano", "options": [
          { "value": "super-milano", "label": "Super Milano" }, { "value": "super", "label": "Super" },
          { "value": "reggio", "label": "Reggio" }, { "value": "descafeinado", "label": "Descafeinado" } ] },
        { "type": "text", "id": "fallback_handle", "label": "t:sections.blends.fallback_handle", "default": "lote-super-milano" },
        { "type": "text", "id": "title", "label": "t:sections.blends.title", "info": "t:settings.blank_uses_product" },
        { "type": "text", "id": "character", "label": "t:sections.blends.character", "info": "t:settings.blank_uses_product" },
        { "type": "text", "id": "chips", "label": "t:sections.blends.chips", "info": "t:sections.blends.chips_info" },
        { "type": "text", "id": "ideal_for", "label": "t:sections.blends.ideal_for", "info": "t:settings.blank_uses_product" },
        { "type": "image_picker", "id": "image", "label": "t:sections.blends.image", "info": "t:settings.blank_uses_product" }
      ]
    }
  ],
  "enabled_on": { "templates": ["index"] },
  "presets": [{ "name": "t:sections.blends.name" }]
}
{% endschema %}
