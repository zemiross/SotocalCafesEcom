{%- comment -%} "Despensa do Norte" contents (brief §9): a metaobject list (gift_box_item) on the product. {%- endcomment -%}
{%- liquid
  assign items = product.metafields.sotocal.gift_box_items.value
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'product.giftbox_heading' | t
  endif
-%}
<section class="section section--tight giftbox" data-theme="ink" aria-labelledby="GiftBox-{{ section.id }}">
  <div class="container grid">
    <div class="col-left">
      <h2 class="h2" id="GiftBox-{{ section.id }}">{{ heading }}</h2>
      <p class="lead" style="margin-top:16px">{{ 'product.giftbox_text' | t }}</p>
    </div>
    <div class="col-right">
      {%- if items.size > 0 -%}
        <ul class="giftbox__list" role="list">
          {%- for it in items -%}
            <li>
              <span class="giftbox__qty tabular">{{ it.quantity.value }}</span>
              {%- if it.product.value -%}<a class="link" href="{{ it.product.value.url }}">{{ it.name.value }}</a>{%- else -%}{{ it.name.value }}{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p>{% render 'tbc', note: 'conteúdo da Despensa do Norte: café, piri-piri, especiarias, conservas' %}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.giftbox.name",
  "enabled_on": { "templates": ["product", "page"] },
  "settings": [ { "type": "text", "id": "heading", "label": "t:settings.heading", "info": "t:settings.blank_uses_default" } ]
}
{% endschema %}
