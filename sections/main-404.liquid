{%- comment -%} 404: the empty Sotocal cup, static (no new motion), with search and the main routes. {%- endcomment -%}
{%- liquid
  if routes.root_url == '/'
    assign prefix = ''
  else
    assign prefix = routes.root_url
  endif
-%}
<section class="section not-found" data-theme="cream" aria-labelledby="NotFoundTitle">
  <div class="container grid">
    <div class="col-left not-found__cup">{% render 'cup-svg', state: 'empty' %}</div>
    <div class="col-right stack">
      <h1 class="h-display" id="NotFoundTitle">{{ 'not_found.heading' | t }}</h1>
      <p class="lead">{{ 'not_found.text' | t }}</p>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <label class="label" for="NotFoundSearch">{{ 'search.label' | t }}</label>
        <div class="search-form__row">
          <input class="input" id="NotFoundSearch" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}">
          <button class="btn btn--solid" type="submit">{{ 'search.submit' | t }}</button>
        </div>
      </form>
      <ul class="hairlines" role="list">
        <li><a class="link" href="{{ prefix }}/collections/cafe">{{ 'home.hero.cta' | t }}</a></li>
        <li><a class="link" href="{{ prefix }}/pages/profissional">{{ 'nav.business' | t }}</a></li>
        <li><a class="link" href="{{ prefix }}/pages/contactos">{{ 'nav.contact' | t }}</a></li>
        <li><a class="link" href="{{ routes.root_url }}">{{ 'general.back_home' | t }}</a></li>
      </ul>
    </div>
  </div>
</section>

{% schema %}
{ "name": "t:sections.main_404.name", "settings": [] }
{% endschema %}
