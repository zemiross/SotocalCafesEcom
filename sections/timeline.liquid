{%- comment -%}
  História timeline (a real sequence, so numbered years are allowed, §5.8). Reads timeline_event metaobjects (sorted by
  "sort"); until the client adds entries, shows the verified events from brief §2 (locale strings) plus a [[TBC]] marker.
{%- endcomment -%}
{%- liquid
  assign events = shop.metaobjects.timeline_event.values | sort: 'sort'
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'pages.historia.timeline_heading' | t
  endif
-%}
<section class="section timeline" data-theme="{{ section.settings.theme }}" aria-labelledby="Timeline-{{ section.id }}">
  <div class="container">
    <h2 class="h2" id="Timeline-{{ section.id }}">{{ heading }}</h2>
    <ol class="timeline__list" role="list">
      {%- if events.size > 0 -%}
        {%- for e in events -%}
          <li class="timeline__item">
            <p class="timeline__year tabular">{{ e.year.value }}</p>
            <div class="timeline__body">
              <h3 class="h3">{{ e.title.value }}</h3>
              {%- if e.text != blank -%}<p>{{ e.text.value | newline_to_br }}</p>{%- endif -%}
            </div>
            {%- if e.image != blank -%}<div class="timeline__media">{{ e.image.value | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 1024px) 20vw, 60vw' }}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for n in (1..6) -%}
          {%- assign base = 'pages.historia.event_' | append: n -%}
          <li class="timeline__item">
            <p class="timeline__year tabular">{{ base | append: '.year' | t }}</p>
            <div class="timeline__body">
              <h3 class="h3">{{ base | append: '.title' | t }}</h3>
              <p>{{ base | append: '.text' | t }}</p>
            </div>
          </li>
        {%- endfor -%}
        <li class="timeline__item"><p class="timeline__year">…</p><div class="timeline__body"><p>{% render 'tbc', note: 'outros marcos da história' %}</p></div></li>
      {%- endif -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.timeline.name",
  "settings": [
    { "type": "select", "id": "theme", "label": "t:settings.theme", "default": "ink", "options": [ { "value": "cream", "label": "t:settings.cream" }, { "value": "ink", "label": "t:settings.ink" } ] },
    { "type": "text", "id": "heading", "label": "t:settings.heading", "info": "t:settings.blank_uses_default" }
  ],
  "presets": [{ "name": "t:sections.timeline.name" }]
}
{% endschema %}
