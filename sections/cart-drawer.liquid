{%- comment -%}
  Cart drawer (brief §8), re-rendered through the Section Rendering API by cart-drawer.js (DECISIONS D19).
  Goal-gradient free-shipping bar; "Levantar num café Sotocal" toggle saved as cart attributes pickup_cafe_id /
  pickup_cafe_name / pickup_cafe_city (default option (a) in ADMIN-SETUP); one upsell; "IVA incluído"; checkout.
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign remaining_money = remaining | money
  if threshold > 0
    assign ratio = cart.total_price | times: 1.0 | divided_by: threshold
    if ratio > 1
      assign ratio = 1
    endif
  else
    assign ratio = 1
  endif
  assign pickup_id = cart.attributes.pickup_cafe_id
  assign upsell = settings.upsell_product
  assign upsell_in_cart = false
  for item in cart.items
    if item.product_id == upsell.id
      assign upsell_in_cart = true
    endif
  endfor
-%}
<dialog id="cart-drawer" class="side-drawer" aria-labelledby="CartDrawerTitle" data-cart-drawer>
  <div class="side-drawer__inner" data-cart-drawer-inner>
    <div class="side-drawer__head">
      <h2 class="side-drawer__title" id="CartDrawerTitle">{{ 'cart.title' | t }} <span class="tabular" data-cart-drawer-count>({{ cart.item_count }})</span></h2>
      <button class="icon-btn" type="button" data-dialog-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'general.close' | t }}</span></button>
    </div>

    <div class="side-drawer__body">
      <p class="visually-hidden" role="status" aria-live="polite" data-cart-status></p>
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty stack">
          <p class="h3">{{ 'cart.empty' | t }}</p>
          <p class="muted">{{ 'cart.empty_text' | t }}</p>
          <a class="btn btn--primary" href="{% if routes.root_url == '/' %}{% else %}{{ routes.root_url }}{% endif %}/collections/cafe">{{ 'home.hero.cta' | t }}</a>
        </div>
      {%- else -%}
        <div class="ship-progress">
          <p class="small" data-ship-message>
            {%- if threshold > 0 and remaining > 0 -%}
              {{ 'cart.shipping_remaining_html' | t: amount: remaining_money }}
            {%- elsif threshold > 0 -%}
              {{ 'cart.shipping_free' | t }}
            {%- endif -%}
          </p>
          {%- if threshold > 0 -%}
            <div class="ship-progress__track" role="progressbar" aria-label="{{ 'cart.shipping_progress' | t }}"
                 aria-valuemin="0" aria-valuemax="{{ threshold | divided_by: 100 }}" aria-valuenow="{{ cart.total_price | divided_by: 100 }}">
              <div class="ship-progress__bar" style="--p: {{ ratio }}"></div>
            </div>
          {%- endif -%}
        </div>

        <ul class="cart-lines" role="list">
          {%- for item in cart.items -%}
            <li class="cart-line" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
              <div class="cart-line__media">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', width: 80, height: 80 }}
                {%- endif -%}
              </div>
              <div>
                <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="cart-line__meta">{{ item.variant.title }}</p>{%- endunless -%}
                {%- if item.selling_plan_allocation -%}<p class="cart-line__meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>{%- endif -%}
                {%- for prop in item.properties -%}{%- assign prop_first = prop.first | slice: 0 -%}{%- unless prop_first == '_' or prop.last == blank -%}<p class="cart-line__meta">{{ prop.first }}: {{ prop.last }}</p>{%- endunless -%}{%- endfor -%}
                <p class="cart-line__meta">{% render 'unit-price', variant: item.variant %}</p>
                <div class="cart-line__actions">
                  <div class="qty">
                    <button type="button" data-qty-change="{{ item.quantity | minus: 1 }}" data-line-index="{{ forloop.index }}" aria-label="{{ 'cart.decrease' | t: title: item.product.title }}">{% render 'icon', name: 'minus', class: 'icon--sm' %}</button>
                    <input type="number" inputmode="numeric" min="0" value="{{ item.quantity }}" data-qty-input data-line-index="{{ forloop.index }}" aria-label="{{ 'cart.quantity_for' | t: title: item.product.title }}">
                    <button type="button" data-qty-change="{{ item.quantity | plus: 1 }}" data-line-index="{{ forloop.index }}" aria-label="{{ 'cart.increase' | t: title: item.product.title }}">{% render 'icon', name: 'plus', class: 'icon--sm' %}</button>
                  </div>
                  <button class="cart-line__remove" type="button" data-qty-change="0" data-line-index="{{ forloop.index }}">{{ 'cart.remove' | t }}<span class="visually-hidden">: {{ item.product.title }}</span></button>
                </div>
              </div>
              <p class="cart-line__price">{{ item.final_line_price | money }}</p>
            </li>
          {%- endfor -%}
        </ul>

        {%- if settings.pickup_enabled -%}
          {%- paginate shop.metaobjects.partner_cafe.values by 250 -%}
          {%- assign cafes = shop.metaobjects.partner_cafe.values -%}
          <div class="pickup" data-pickup>
            <label class="switch" for="PickupToggle">
              <span>{% render 'icon', name: 'cup', class: 'icon--sm' %} {{ 'cart.pickup_toggle' | t }}</span>
              <input type="checkbox" id="PickupToggle" role="switch" data-pickup-toggle{% if pickup_id != blank %} checked{% endif %} aria-controls="PickupPanel">
            </label>
            <div id="PickupPanel" class="pickup__panel" data-pickup-panel{% if pickup_id == blank %} hidden{% endif %}>
              <p class="small muted">{{ 'cart.pickup_help' | t }}</p>
              <label class="visually-hidden" for="PickupSearch">{{ 'cart.pickup_search' | t }}</label>
              <input class="input" id="PickupSearch" type="search" placeholder="{{ 'cart.pickup_search' | t }}" autocomplete="off" data-pickup-search style="margin-top:12px">
              <fieldset style="border:0;padding:0;margin:0">
                <legend class="visually-hidden">{{ 'cart.pickup_choose' | t }}</legend>
                <ul class="pickup__list" role="list" data-pickup-list>
                  {%- for cafe in cafes -%}
                    {%- if cafe.consent_publish.value and cafe.pickup_enabled.value -%}
                      <li data-search-text="{{ cafe.name | downcase | escape }} {{ cafe.city | downcase | escape }} {{ cafe.district | downcase | escape }}">
                        <label>
                          <input type="radio" name="pickup_cafe" value="{{ cafe.system.handle }}" data-name="{{ cafe.name | escape }}" data-city="{{ cafe.city | escape }}"{% if pickup_id == cafe.system.handle %} checked{% endif %}>
                          <span><strong>{{ cafe.name }}</strong><br><span class="small muted">{{ cafe.address }}, {{ cafe.city }}</span></span>
                        </label>
                      </li>
                    {%- endif -%}
                  {%- else -%}
                    <li class="small muted">{{ 'cart.pickup_none' | t }}</li>
                  {%- endfor -%}
                </ul>
              </fieldset>
            </div>
          </div>
          {%- endpaginate -%}
        {%- endif -%}

        {%- if upsell != blank and upsell_in_cart == false and upsell.available -%}
          <div class="upsell">
            <div class="upsell__media">{%- if upsell.featured_image -%}{{ upsell.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</div>
            <div>
              <p class="small muted">{{ 'cart.upsell' | t }}</p>
              <a class="cart-line__title" href="{{ upsell.url }}">{{ upsell.title }}</a>
              <p class="small tabular">{{ upsell.price | money }} {% render 'unit-price', variant: upsell.selected_or_first_available_variant %}</p>
            </div>
            {%- form 'product', upsell, data-cart-add: '' -%}
              <input type="hidden" name="id" value="{{ upsell.selected_or_first_available_variant.id }}">
              <button class="btn btn--outline btn--sm" type="submit">{{ 'cart.add_short' | t }}<span class="visually-hidden">: {{ upsell.title }}</span></button>
            {%- endform -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="side-drawer__foot">
        <p class="price" style="justify-content:space-between">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span><span class="price__current" data-cart-subtotal>{{ cart.total_price | money }}</span> <span class="price__tax">{{ 'product.tax_included' | t }}</span></span>
        </p>
        <p class="small muted">{{ 'cart.shipping_at_checkout' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button class="btn btn--primary btn--block" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        </form>
        <a class="text-link" href="{{ routes.cart_url }}" style="justify-self:center">{{ 'cart.view' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</dialog>

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "settings": []
}
{% endschema %}
