{%- comment -%}
  People (História). Real photos only (never AI-generated people, §5.4): until portraits are supplied, a plain
  placeholder frame with the person's initials. Reads person metaobjects; falls back to the two verified profiles (§2).
{%- endcomment -%}
{%- liquid
  assign people = shop.metaobjects.person.values
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'pages.historia.people_heading' | t
  endif
-%}
<section class="section people" data-theme="cream" aria-labelledby="People-{{ section.id }}">
  <div class="container">
    <h2 class="h2" id="People-{{ section.id }}">{{ heading }}</h2>
    <ul class="people__list" role="list">
      {%- if people.size > 0 -%}
        {%- for p in people -%}
          <li class="person">
            <div class="person__photo">
              {%- if p.photo != blank -%}{{ p.photo.value | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 1024px) 30vw, 80vw', alt: p.name.value }}{%- else -%}<span class="person__initials" aria-hidden="true">{{ p.name.value | slice: 0 }}</span>{%- endif -%}
            </div>
            <h3 class="h3">{{ p.name.value }}</h3>
            <p class="person__role">{{ p.role.value }}</p>
            {%- if p.bio != blank -%}<p>{{ p.bio.value | newline_to_br }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        <li class="person">
          <div class="person__photo"><span class="person__initials" aria-hidden="true">JB</span></div>
          <h3 class="h3">José Barbosa</h3>
          <p class="person__role">{{ 'facts.founder_role' | t }} {% render 'tbc', note: 'título preferido' %}</p>
          <p>{{ 'pages.historia.jose_bio' | t }}</p>
          <p class="small">{% render 'tbc', note: 'fotografia real de José Barbosa' %}</p>
        </li>
        <li class="person">
          <div class="person__photo"><span class="person__initials" aria-hidden="true">MJB</span></div>
          <h3 class="h3">Maria José Barbosa</h3>
          <p class="person__role">{{ 'facts.director_role' | t }}</p>
          <p>{{ 'pages.historia.maria_jose_bio' | t }} {% render 'tbc', note: 'nome exato da confraria e anos' %}</p>
          <p class="small">{% render 'tbc', note: 'fotografia real de Maria José Barbosa' %}</p>
        </li>
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.people.name",
  "settings": [ { "type": "text", "id": "heading", "label": "t:settings.heading", "info": "t:settings.blank_uses_default" } ],
  "presets": [{ "name": "t:sections.people.name" }]
}
{% endschema %}
