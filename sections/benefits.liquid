{%- comment -%}
  Profissional benefits (brief §2 HoReCa offer), chunked into two groups of three (Miller), hairline lists, no icon cards.
  Blank settings use the verified offer from the locale files.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'pages.profissional.benefits_heading' | t
  endif
-%}
<section class="section benefits" data-theme="cream" aria-labelledby="Benefits-{{ section.id }}">
  <div class="container">
    <h2 class="h2" id="Benefits-{{ section.id }}">{{ heading }}</h2>
    <div class="grid benefits__grid">
      {%- for g in (1..2) -%}
        {%- liquid
          assign gkey = 'pages.profissional.group_' | append: g
          assign items = gkey | append: '_items' | t | split: '|'
        -%}
        <div class="{% if g == 1 %}col-left{% else %}col-right{% endif %}">
          <h3 class="h4 benefits__group">{{ gkey | append: '_title' | t }}</h3>
          <ul class="hairlines" role="list">
            {%- for it in items -%}<li>{{ it }}</li>{%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
    <p class="benefits__note small muted">{{ 'pages.profissional.no_machines' | t }}</p>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.benefits.name",
  "settings": [ { "type": "text", "id": "heading", "label": "t:settings.heading", "info": "t:settings.blank_uses_default" } ],
  "presets": [{ "name": "t:sections.benefits.name" }]
}
{% endschema %}
