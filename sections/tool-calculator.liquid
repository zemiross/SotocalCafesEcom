{%- comment -%}
  Cost-per-cup calculator (docs/seo/06-ws6-tools.md). Inputs: format, pack price, pack weight or capsule count, dose, cups per day.
  Outputs per cup, month and year, compared with reference prices from the `competitor` metaobject (each with source and date read).
  Sotocal presets come from real prices only: products tagged `preco-provisorio` are never offered, so a placeholder 1,00 EUR can
  never feed a calculation. assets/calculator.js does the maths; the markup works as a labelled form.
{%- endcomment -%}
{%- liquid
  assign col = section.settings.collection | default: collections['cafe']
  assign refs = shop.metaobjects.competitor.values
  assign latest = 0
  for r in refs
    assign stamp = r.accessed_on.value | date: '%s' | plus: 0
    if stamp > latest
      assign latest = stamp
    endif
  endfor
  assign now = 'now' | date: '%s' | plus: 0
-%}
<section class="section tool calc" data-theme="cream" data-calc aria-labelledby="CalcTitle-{{ section.id }}">
  <div class="container grid">
    <form class="calc__form col-left stack" data-calc-form novalidate aria-labelledby="CalcTitle-{{ section.id }}">
      <h2 class="h3" id="CalcTitle-{{ section.id }}">{{ 'tools.calculator.form_heading' | t }}</h2>

      <fieldset class="radio-pills" data-calc-format>
        <legend class="label">{{ 'tools.calculator.format' | t }}</legend>
        {%- for f in (1..3) -%}
          {%- case f -%}
            {%- when 1 -%}{%- assign value = 'grao' -%}{%- assign label = 'tools.calculator.grain' | t -%}
            {%- when 2 -%}{%- assign value = 'moido' -%}{%- assign label = 'tools.calculator.ground' | t -%}
            {%- when 3 -%}{%- assign value = 'capsula' -%}{%- assign label = 'tools.calculator.capsule' | t -%}
          {%- endcase -%}
          <label class="radio-pill"><input type="radio" name="format" value="{{ value }}"{% if f == 1 %} checked{% endif %}><span>{{ label }}</span></label>
        {%- endfor -%}
      </fieldset>

      <div class="field" data-calc-preset-wrap hidden>
        <label for="CalcPreset-{{ section.id }}">{{ 'tools.calculator.preset' | t }}</label>
        <select class="select" id="CalcPreset-{{ section.id }}" data-calc-preset>
          <option value="">{{ 'tools.calculator.preset_none' | t }}</option>
          {%- for p in col.products -%}
            {%- comment -%} Placeholder prices are offered only while the TBC markers are on (pre-launch review), and labelled. {%- endcomment -%}
            {%- assign provisional = false -%}
            {%- if p.tags contains 'preco-provisorio' -%}{%- assign provisional = true -%}{%- endif -%}
            {%- if provisional == false or settings.show_tbc_markers or request.design_mode -%}
              {%- for v in p.variants -%}
                {%- if v.available and v.weight > 0 -%}
                  {%- assign vformat = 'moido' -%}
                  {%- assign vtitle = v.title | downcase -%}
                  {%- if vtitle contains 'grão' or vtitle contains 'grao' -%}{%- assign vformat = 'grao' -%}{%- endif -%}
                  <option value="{{ v.id }}" data-format="{{ vformat }}" data-price="{{ v.price | divided_by: 100.0 }}" data-weight="{{ v.weight }}">{{ p.title }}: {{ v.title }}{% if provisional %} ({{ 'tools.calculator.provisional' | t }}){% endif %}</option>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </select>
      </div>

      <div class="field">
        <label for="CalcPrice-{{ section.id }}">{{ 'tools.calculator.price' | t }}</label>
        <input class="input" id="CalcPrice-{{ section.id }}" name="price" type="text" inputmode="decimal" autocomplete="off" data-calc-price aria-describedby="CalcErr-{{ section.id }}">
      </div>
      <div class="field" data-calc-weight-field>
        <label for="CalcWeight-{{ section.id }}">{{ 'tools.calculator.weight' | t }}</label>
        <input class="input" id="CalcWeight-{{ section.id }}" name="weight" type="text" inputmode="decimal" autocomplete="off" data-calc-weight aria-describedby="CalcErr-{{ section.id }}">
      </div>
      <div class="field" data-calc-units-field hidden>
        <label for="CalcUnits-{{ section.id }}">{{ 'tools.calculator.units' | t }}</label>
        <input class="input" id="CalcUnits-{{ section.id }}" name="units" type="text" inputmode="numeric" autocomplete="off" data-calc-units aria-describedby="CalcErr-{{ section.id }}">
      </div>
      <div class="field" data-calc-dose-field>
        <label for="CalcDose-{{ section.id }}">{{ 'tools.calculator.dose' | t }}</label>
        <input class="input" id="CalcDose-{{ section.id }}" name="dose" type="text" inputmode="decimal" autocomplete="off" value="{{ section.settings.default_dose }}" data-calc-dose aria-describedby="CalcDoseHint-{{ section.id }} CalcErr-{{ section.id }}">
        <span class="hint" id="CalcDoseHint-{{ section.id }}">{{ 'tools.calculator.dose_hint' | t: dose: section.settings.default_dose }}</span>
      </div>
      <div class="field">
        <label for="CalcCups-{{ section.id }}">{{ 'tools.calculator.cups' | t }}</label>
        <input class="input" id="CalcCups-{{ section.id }}" name="cups" type="text" inputmode="decimal" autocomplete="off" value="2" data-calc-cups aria-describedby="CalcErr-{{ section.id }}">
      </div>
      <p class="field-error" id="CalcErr-{{ section.id }}" role="alert" data-calc-error hidden>{{ 'tools.calculator.error_number' | t }}</p>
      <div class="calc__actions">
        <button class="btn btn--outline btn--sm" type="button" data-calc-reset>{{ 'tools.calculator.reset' | t }}</button>
        <button class="btn btn--outline btn--sm" type="button" data-calc-copy hidden>{{ 'tools.calculator.copy_link' | t }}</button>
        <span class="small muted" role="status" data-calc-copied></span>
      </div>
      <noscript><p class="small">{{ 'tools.calculator.noscript' | t }}</p></noscript>
    </form>

    <div class="calc__out col-right stack">
      <div role="status" aria-live="polite" data-calc-result>
        <h2 class="h3">{{ 'tools.calculator.result_heading' | t }}</h2>
        <p class="muted" data-calc-empty>{{ 'tools.calculator.empty' | t }}</p>
        <dl class="fic calc__numbers" data-calc-numbers hidden>
          <div><dt>{{ 'tools.calculator.per_cup' | t }}</dt><dd class="tabular" data-calc-per-cup></dd></div>
          <div><dt>{{ 'tools.calculator.per_month' | t }}</dt><dd class="tabular" data-calc-per-month></dd></div>
          <div><dt>{{ 'tools.calculator.per_year' | t }}</dt><dd class="tabular" data-calc-per-year></dd></div>
        </dl>
        <p class="small muted" data-calc-numbers-note hidden>{{ 'tools.calculator.assumption' | t }}</p>
      </div>

      {%- if refs.size > 0 -%}
        <div data-calc-compare hidden>
          <h2 class="h3" id="CalcCompare-{{ section.id }}">{{ 'tools.calculator.compare_heading' | t }}</h2>
          <div class="compare__scroll" role="region" aria-labelledby="CalcCompare-{{ section.id }}" tabindex="0">
            <table class="compare__table">
              <caption class="visually-hidden">{{ 'tools.calculator.compare_caption' | t }}</caption>
              <thead>
                <tr>
                  <th scope="col">{{ 'tools.calculator.col_brand' | t }}</th>
                  <th scope="col">{{ 'tools.calculator.col_format' | t }}</th>
                  <th scope="col">{{ 'tools.calculator.col_per_kg' | t }}</th>
                  <th scope="col">{{ 'tools.calculator.col_per_cup' | t }}</th>
                  <th scope="col">{{ 'tools.calculator.col_source' | t }}</th>
                </tr>
              </thead>
              <tbody id="CalcRows-{{ section.id }}" data-calc-rows></tbody>
            </table>
          </div>
          <button class="btn btn--outline btn--sm" type="button" data-calc-more aria-controls="CalcRows-{{ section.id }}" hidden></button>
          <p class="small muted">{{ 'tools.calculator.refs_note' | t }}</p>
        </div>
      {%- elsif request.design_mode or settings.show_tbc_markers -%}
        <p>{% render 'tbc', note: 'preços de referência de outras marcas (metaobjeto competitor, com fonte e data)' %}</p>
      {%- endif -%}

      <div class="calc__cite">
        <h2 class="h3">{{ 'tools.calculator.cite_heading' | t }}</h2>
        {%- if latest > 0 -%}
          {%- assign cite_date = latest | date: '%d/%m/%Y' -%}
          <p class="small">{{ 'tools.calculator.cite_with_date' | t: url: canonical_url, date: cite_date }}</p>
        {%- else -%}
          <p class="small">{{ 'tools.calculator.cite' | t: url: canonical_url }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-calc-refs>
    [
      {%- for r in refs -%}
        {%- assign stamp = r.accessed_on.value | date: '%s' | plus: 0 -%}
        {%- assign age_days = now | minus: stamp | divided_by: 86400 | floor -%}
        {
          "name": {{ r.name.value | json }},
          "product": {{ r.product.value | json }},
          "format": {{ r.format.value | json }},
          "perKg": {{ r.price_per_kg.value | default: 0 | json }},
          "packPrice": {{ r.pack_price.value | default: 0 | json }},
          "packUnits": {{ r.pack_units.value | default: 0 | json }},
          "kind": {{ r.price_kind.value | json }},
          "source": {{ r.source_url.value | json }},
          "date": {{ r.accessed_on.value | date: '%d/%m/%Y' | json }},
          "stale": {% if age_days > 90 %}true{% else %}false{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
  <script type="application/json" data-calc-strings>
    {
      "you": {{ 'tools.calculator.you' | t | json }},
      "stale": {{ 'tools.calculator.stale' | t | json }},
      "grain": {{ 'tools.calculator.grain' | t | json }},
      "ground": {{ 'tools.calculator.ground' | t | json }},
      "capsule": {{ 'tools.calculator.capsule' | t | json }},
      "promo": {{ 'tools.calculator.promo' | t | json }},
      "copied": {{ 'tools.calculator.copied' | t | json }},
      "opens": {{ 'tools.calculator.opens_new' | t | json }},
      "showAll": {{ 'tools.calculator.show_all' | t: count: '__N__' | json }},
      "showFewer": {{ 'tools.calculator.show_fewer' | t | json }}
    }
  </script>
</section>
<script src="{{ 'calculator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.tool_calculator.name",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "collection", "id": "collection", "label": "t:sections.tool_calculator.collection", "info": "t:sections.tool_calculator.collection_info" },
    { "type": "number", "id": "default_dose", "label": "t:sections.tool_calculator.default_dose", "default": 7 }
  ],
  "presets": [{ "name": "t:sections.tool_calculator.name" }]
}
{% endschema %}
