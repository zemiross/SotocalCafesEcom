{%- comment -%}
  Page opener: breadcrumbs, H1 (the page title unless overridden), intro, up to one CTA. Ink or cream (§5.8: ink carries
  real weight on interior pages). Intro text falls back to a locale string chosen by `preset` so both languages ship.
{%- endcomment -%}
{%- liquid
  capture years
    render 'years'
  endcapture
  assign years = years | strip
  assign heading = section.settings.heading | default: page.title
  assign intro = section.settings.intro
  if intro == blank and section.settings.preset != 'none'
    assign key = 'pages.' | append: section.settings.preset | append: '.intro'
    if settings.catalogue_only and section.settings.preset == 'faq'
      assign key = 'pages.faq.intro_catalogue'
    elsif settings.catalogue_only and section.settings.preset == 'contact'
      assign key = 'pages.contact.intro_catalogue'
    endif
    assign intro = key | t: years: years
  endif
  if section.settings.preset != 'none' and section.settings.heading == blank
    assign hkey = 'pages.' | append: section.settings.preset | append: '.heading'
    assign heading = hkey | t
  endif
  assign cta = section.settings.cta_label
  if cta == blank and section.settings.preset == 'profissional'
    assign cta = 'home.audiences.business_cta' | t
  endif
-%}
<section class="section page-hero" data-theme="{{ section.settings.theme }}" aria-labelledby="PageTitle">
  <div class="container">
    {% render 'breadcrumbs' %}
    <div class="grid page-hero__grid">
      <h1 class="h-display page-hero__title" id="PageTitle">{{ heading }}</h1>
      {%- if intro != blank or cta != blank -%}
        <div class="page-hero__body">
          {%- if intro != blank -%}<p class="lead">{{ intro }}</p>{%- endif -%}
          {%- if cta != blank -%}<a class="btn btn--primary" href="{{ section.settings.cta_link | default: '#contacto' }}">{{ cta }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.page_hero.name",
  "settings": [
    { "type": "select", "id": "theme", "label": "t:settings.theme", "default": "cream", "options": [ { "value": "cream", "label": "t:settings.cream" }, { "value": "ink", "label": "t:settings.ink" } ] },
    { "type": "select", "id": "preset", "label": "t:sections.page_hero.preset", "default": "none", "options": [
      { "value": "none", "label": "t:sections.page_hero.preset_none" },
      { "value": "historia", "label": "História" }, { "value": "torra", "label": "A torra" }, { "value": "profissional", "label": "Profissional" },
      { "value": "locator", "label": "Onde beber Sotocal" }, { "value": "facts", "label": "Sobre a Sotocal" }, { "value": "contact", "label": "Contactos" },
      { "value": "faq", "label": "Perguntas frequentes" }, { "value": "pickup", "label": "Levantar no café" }, { "value": "subscription", "label": "Subscrição" },
      { "value": "giftbox", "label": "Despensa do Norte" }, { "value": "calculator", "label": "Calculadora" }, { "value": "quiz", "label": "Questionário" } ] },
    { "type": "text", "id": "heading", "label": "t:settings.heading", "info": "t:sections.page_hero.heading_info" },
    { "type": "textarea", "id": "intro", "label": "t:settings.text", "info": "t:settings.blank_uses_default" },
    { "type": "text", "id": "cta_label", "label": "t:settings.cta_label" },
    { "type": "url", "id": "cta_link", "label": "t:settings.cta_link" }
  ],
  "presets": [{ "name": "t:sections.page_hero.name" }]
}
{% endschema %}
