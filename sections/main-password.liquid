{%- comment -%} Password page (ink): "Estamos a torrar. Abrimos em breve." + newsletter sign-up + store password form. {%- endcomment -%}
{%- liquid
  assign message = shop.password_message
  if message == blank
    assign message = 'password.text' | t
  endif
-%}
<section class="section password" data-theme="ink" aria-labelledby="PasswordTitle">
  <div class="container stack password__inner">
    {% render 'logo', width: 120 %}
    <h1 class="h-display" id="PasswordTitle">{{ 'password.heading' | t }}</h1>
    <p class="lead">{{ message }}</p>
    {% render 'newsletter-form', id: 'PasswordNewsletter' %}
    <details class="password__login">
      <summary class="text-link">{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'stack' -%}
        {%- if form.errors -%}<p class="form-status" role="alert">{{ 'password.error' | t }}</p>{%- endif -%}
        <div class="field"><label for="StorePassword">{{ 'password.label' | t }}</label><input class="input" id="StorePassword" type="password" name="password" autocomplete="current-password"></div>
        <button class="btn btn--outline" type="submit">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "t:sections.main_password.name", "settings": [] }
{% endschema %}
