{%- comment -%} Search results page (internal search URLs stay noindexed by Shopify's default robots rules). {%- endcomment -%}
{%- paginate search.results by 24 -%}
<section class="section" data-theme="cream" aria-labelledby="SearchTitle">
  <div class="container">
    {% render 'breadcrumbs' %}
    <h1 class="h-display" id="SearchTitle" style="margin-block: 24px 32px">{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="margin-bottom: 48px">
      <label class="label" for="SearchPageInput">{{ 'search.label' | t }}</label>
      <div class="search-form__row">
        <input class="input" id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
        <button class="btn btn--solid" type="submit">{{ 'search.submit' | t }}</button>
      </div>
    </form>
    {%- if search.performed -%}
      <p class="muted" role="status">{{ 'search.results_for' | t: count: search.results_count, terms: search.terms }}</p>
      {%- if search.results_count > 0 -%}
        <ul class="tiles" role="list" style="margin-top: 32px">
          {%- for item in search.results -%}
            <li>
              {%- if item.object_type == 'product' -%}
                {% render 'product-tile', product: item, heading: 'h2' %}
              {%- else -%}
                <article class="tile">
                  <h2 class="tile__title"><a href="{{ item.url }}">{{ item.title }}</a></h2>
                  <p class="tile__char">{{ item.content | strip_html | truncatewords: 20 }}</p>
                </article>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p class="h3" style="margin-top: 32px">{{ 'search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "t:sections.main_search.name", "settings": [] }
{% endschema %}
